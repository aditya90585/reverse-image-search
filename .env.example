# Required: SerpApi reverse image search
SERPAPI_API_KEY=

# Required before production: canonical public origin, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google Search Console HTML meta verification token
GOOGLE_SITE_VERIFICATION=

# Optional: public support email shown on the Contact and Privacy pages
CONTACT_EMAIL=hello@yourdomain.com

# Optional: Google AdSense. Configure only after the site is approved.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_PUBLISHER_ID=pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_GUIDES=

# Strongly recommended for production: Upstash Redis REST credentials
# Distributed per-IP search throttling: 8 requests per 60 seconds
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Gemini is not used by the reverse image search flow
GEMINI_API_KEY=
