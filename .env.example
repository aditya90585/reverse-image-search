# Required: SerpApi reverse image search (server-only)
SERPAPI_API_KEY=

# Required before production: canonical public origin, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google Search Console HTML meta verification token
GOOGLE_SITE_VERIFICATION=

# Required before launch: a real support/privacy contact address
CONTACT_EMAIL=hello@yourdomain.com

# Search budget protection. Defaults: 3 searches/IP/UTC day and 200 total searches/month.
SEARCH_DAILY_LIMIT=3
SEARCH_MONTHLY_BUDGET=200

# Required in production: Upstash Redis REST credentials for shared, atomic quotas.
# Do not launch production search without these values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Google AdSense. Keep disabled until site approval and CMP configuration.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_PUBLISHER_ID=pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_GUIDES=

# Optional: Gemini is not used by the reverse search flow
GEMINI_API_KEY=
